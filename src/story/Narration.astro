---
// The guided narration: one caption at a time, timed to the scroll (src/story/schedule.ts), a plain-language clock,
// the stage you are in and a thin progress line. Purely visual (aria-hidden): the same text is in the story DOM
// for screen readers, and chapter changes are announced through the live region.
import { CHAPTERS, CHAPTER_STARTS } from '../time/chapters.ts';
import { supHtml } from '../lib/sup.ts';

export interface NarrationCaption {
  chapter: number;
  start: number;
  kind: 'intro' | 'beat';
  text: string;
  kicker?: string;
  title?: string;
  time?: string;
}

interface Props {
  captions: NarrationCaption[];
  titles: string[];
}

const { captions, titles } = Astro.props;
const pad = (n: number) => String(n).padStart(2, '0');
---

<div class="narration" data-narration data-titles={JSON.stringify(titles)}>
  <div class="visual" aria-hidden="true">
    <div class="bar">
      <i data-bar></i>
      {CHAPTER_STARTS.slice(1, -1).map((p) => <span style={`left: ${(p * 100).toFixed(3)}%`}></span>)}
    </div>

    <div class="top">
      <p class="stage">
        <span class="num" data-stage-num>01 / {pad(CHAPTERS.length)}</span>
        <span class="name" data-stage-name>{titles[0]}</span>
        <span class="acc" data-acc-chip hidden><i></i><span data-acc-label></span></span>
      </p>
      <p class="clock">
        <span class="when" data-when></span>
        <span class="phys" data-phys></span>
      </p>
    </div>

    <div class="caps">
      {
        captions.map((c) =>
          c.kind === 'intro' ? (
            <div class="cap intro" data-cap data-start={c.start} data-chapter={c.chapter}>
              <p class="kicker">
                <span>Stage {c.chapter + 1}</span>
                {c.kicker && <span set:html={supHtml(c.kicker)} />}
              </p>
              <h2>{c.title}</h2>
              <p class="summary" set:html={supHtml(c.text)} />
              <p class="note" data-cap-note data-scene={CHAPTERS[c.chapter]!.sceneId} hidden />
            </div>
          ) : (
            <div class="cap beat" data-cap data-start={c.start} data-chapter={c.chapter}>
              {c.time && <p class="time" set:html={supHtml(c.time)} />}
              <p class="text" set:html={supHtml(c.text)} />
            </div>
          ),
        )
      }
    </div>
  </div>
  <p class="sr-only" aria-live="polite" data-live></p>
</div>

<script>
  import { initNarration } from './narration.ts';
  initNarration(document.querySelector<HTMLElement>('[data-narration]')!);
</script>

<style>
  .narration {
    position: fixed;
    inset: 0;
    z-index: 15;
    pointer-events: none;
  }
  /* Readability: a soft shade under the caption corner and the top line, never a box. */
  .visual::before {
    content: '';
    position: absolute;
    inset: 0;
    background:
      radial-gradient(ellipse 60vw 55svh at 0% 100%, rgb(2 2 5 / 0.62), rgb(2 2 5 / 0) 100%),
      linear-gradient(rgb(2 2 5 / 0.45), rgb(2 2 5 / 0) 7rem);
    transition: opacity 0.8s var(--ease-cosmic);
  }
  .narration.is-hero .visual::before {
    opacity: 0;
  }
  .bar {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 2px;
    background: rgb(255 255 255 / 0.07);
  }
  .bar i {
    position: absolute;
    inset: 0;
    background: linear-gradient(90deg, rgb(255 217 160 / 0.5), var(--color-glow));
    transform-origin: left;
    transform: scaleX(var(--p, 0));
  }
  .bar span {
    position: absolute;
    top: 0;
    width: 1px;
    height: 5px;
    background: rgb(255 255 255 / 0.22);
  }
  .top,
  .bar {
    transition: opacity 0.8s var(--ease-cosmic);
  }
  .narration.is-hero .top,
  .narration.is-hero .bar {
    opacity: 0;
  }
  .top {
    position: absolute;
    top: 1.25rem;
    left: max(1.5rem, 6vw);
    right: max(1.5rem, 4vw);
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 1.5rem;
    text-shadow: 0 1px 16px rgb(0 0 0 / 0.8);
  }
  .stage {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.35rem 0.9rem;
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-mute);
  }
  .stage .name {
    color: var(--color-paper);
  }
  .acc {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    color: var(--acc, var(--color-mute));
  }
  .acc[hidden] {
    display: none;
  }
  .acc i {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: currentColor;
  }
  .clock {
    display: grid;
    justify-items: end;
    gap: 0.3rem;
    text-align: right;
  }
  .when {
    font-family: var(--font-serif);
    font-size: clamp(1.05rem, 1.5vw, 1.3rem);
    color: var(--color-paper);
  }
  .phys {
    font-family: var(--font-mono);
    font-size: 0.64rem;
    letter-spacing: 0.06em;
    color: var(--color-mute);
  }
  [data-acc='measured'] {
    --acc: var(--color-acc-measured);
  }
  [data-acc='simulated'] {
    --acc: var(--color-acc-simulated);
  }
  [data-acc='modelled'] {
    --acc: var(--color-acc-modelled);
  }
  [data-acc='metaphor'] {
    --acc: var(--color-acc-metaphor);
  }

  .caps {
    position: absolute;
    left: max(1.5rem, 6vw);
    bottom: max(3rem, 12svh);
    width: min(36rem, calc(100vw - 3rem));
  }
  .cap {
    position: absolute;
    left: 0;
    bottom: 0;
    width: 100%;
    opacity: 0;
    transform: translateY(16px);
    filter: blur(5px);
    text-shadow: 0 1px 28px rgb(0 0 0 / 0.85);
    transition:
      opacity 0.35s ease,
      transform 0.35s ease,
      filter 0.35s ease;
  }
  .cap.is-on {
    opacity: 1;
    transform: none;
    filter: none;
    transition:
      opacity 0.9s var(--ease-cosmic) 0.3s,
      transform 1.2s var(--ease-cosmic) 0.3s,
      filter 0.9s var(--ease-cosmic) 0.3s;
  }
  .kicker {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem 1rem;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-glow);
  }
  .kicker span:first-child {
    color: var(--color-mute);
  }
  .intro h2 {
    margin-top: 0.6rem;
    font-family: var(--font-serif);
    font-weight: 330;
    font-size: clamp(2.6rem, 5.6vw, 4.6rem);
    line-height: 1;
    letter-spacing: -0.025em;
    color: var(--color-paper);
  }
  .summary {
    margin-top: 1rem;
    font-family: var(--font-serif);
    font-size: clamp(1.15rem, 1.6vw, 1.4rem);
    font-style: italic;
    line-height: 1.45;
    color: var(--color-fog);
  }
  .note {
    margin-top: 1.1rem;
    max-width: 30rem;
    padding-left: 0.8rem;
    border-left: 2px solid var(--acc, var(--color-line-strong));
    font-size: 0.8rem;
    line-height: 1.5;
    color: var(--color-mute);
    text-shadow: 0 1px 12px rgb(0 0 0 / 0.9);
  }
  .note b {
    color: var(--acc);
    font-weight: 500;
  }
  .time {
    margin-bottom: 0.5rem;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.12em;
    color: var(--color-glow);
  }
  .text {
    font-family: var(--font-serif);
    font-size: clamp(1.35rem, 2.1vw, 1.85rem);
    line-height: 1.38;
    letter-spacing: -0.005em;
    color: var(--color-paper);
  }
  @media (max-width: 767px) {
    .visual::before {
      background:
        linear-gradient(0deg, rgb(2 2 5 / 0.75), rgb(2 2 5 / 0) 50svh),
        linear-gradient(rgb(2 2 5 / 0.5), rgb(2 2 5 / 0) 6rem);
    }
    .top {
      top: 0.9rem;
      left: 1rem;
      right: 1rem;
      gap: 0.75rem;
    }
    .stage {
      flex-direction: column;
      gap: 0.25rem;
      font-size: 0.6rem;
    }
    .when {
      font-size: 0.95rem;
    }
    .caps {
      left: 1rem;
      bottom: max(2rem, env(safe-area-inset-bottom));
      width: calc(100vw - 2rem);
    }
    .intro h2 {
      font-size: 2.4rem;
    }
    .text {
      font-size: 1.2rem;
    }
    .note {
      display: none;
    }
  }
</style>
